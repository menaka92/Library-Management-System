<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ShowBooksFormController">
   <children>
      <Label layoutX="36.0" layoutY="35.0" prefHeight="35.0" prefWidth="82.0" text="Books">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <TableView fx:id="btlBook" layoutX="53.0" layoutY="129.0" prefHeight="200.0" prefWidth="438.0">
        <columns>
          <TableColumn fx:id="colBookName" prefWidth="338.0" text="Book Name" />
          <TableColumn fx:id="colOption" prefWidth="99.0" text="Option" />
        </columns>
      </TableView>
      <Button layoutX="491.0" layoutY="40.0" mnemonicParsing="false" onAction="#viewCartOnAction" text="View Cart" />
      <Button layoutX="491.0" layoutY="352.0" mnemonicParsing="false" onAction="#brrowBooksOnAction" text="Burrow Books" />
      <ComboBox fx:id="comCategory" layoutX="53.0" layoutY="70.0" prefWidth="150.0" promptText="Select Category" />
      <Button layoutX="396.0" layoutY="40.0" mnemonicParsing="false" onAction="#backOnAction" prefHeight="25.0" prefWidth="67.0" text="Back" />
   </children>
</AnchorPane>
